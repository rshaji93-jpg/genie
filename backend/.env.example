# ==============================================================================
# 1. AI MODEL KEYS & ENGINE CONFIGURATION (Template Only)
# ==============================================================================
# Comma-separated list of free tier Gemini keys
GEMINI_FREE_KEYS=your_free_key_1,your_free_key_2

# Paid Master Key (Used for Admin Bypass & High-Priority Calls)
GEMINI_MASTER_KEY=

# Admin Email Whitelist (Bypasses client-side BYOK prompts)
ADMIN_EMAIL=rshaji93@gmail.com

# Alternate Providers
OPENROUTER_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
GITHUB_TOKEN=
HUGGINGFACE_API_KEY=

# ==============================================================================
# 2. AUTHENTICATION & OAUTH CREDENTIALS
# ==============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Stable secret (min 32 chars) to sign persistent Genie sessions
GENIE_SESSION_SECRET=
GENIE_ENV=development
GENIE_ENABLE_DEV_AUTH_BYPASS=false
GENIE_DEV_AUTH_EMAIL=admin@example.com

# ==============================================================================
# 3. SMTP & EMAIL DISPATCH
# ==============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
GOOGLE_CLIENT_ID=767453349146-honr4mjea5jgv23andq145fqtcjdor0t.apps.googleusercontent.com
# Optional; set a stable secret of at least 32 characters to sign persistent Genie sessions.
GENIE_SESSION_SECRET=
# Optional local-only shortcut; requires GENIE_ENV=development or this explicit opt-in.
# The endpoint still only responds to localhost browser origins and loopback clients.
GENIE_ENV=
GENIE_ENABLE_DEV_AUTH_BYPASS=false
GENIE_DEV_AUTH_EMAIL=rshaji93@gmail.com
# SMTP is required for Authenticator reset emails; invite emails simulate delivery without it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
